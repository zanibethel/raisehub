{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/tvplayer",
      "destination": "https://github.com/zanibethel/raisehub/releases/download/tv-web-player/TVWebPlayer.apk",
      "permanent": false
    },
    {
      "source": "/webportal",
      "destination": "https://github.com/zanibethel/raisehub/releases/download/webportal/WebPortal.apk",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/business-notifications",
      "schedule": "0 15 * * 1"
    },
    {
      "path": "/api/cron/partner-rewards-report",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/operations-alerts",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/cron/storage-recovery",
      "schedule": "41 6 * * *"
    }
  ]
}
